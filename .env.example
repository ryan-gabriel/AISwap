# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Supabase (Postgres + JWT auth). Service role key is server-only — never ship it in the extension.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth client id used by the extension (same client the extension ships). The backend
# rejects google tokens that were issued to any other client (aud/azp mismatch).
#
# There is deliberately no client secret. This backend never exchanges an authorization code
# for a token; it introspects the access token the extension obtained from Chrome via
# chrome.identity.getAuthToken(). See docs/setup.md.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# App JWT signing (32+ byte secret). Generate one with: openssl rand -base64 32
# The server refuses to boot in production if this is a placeholder or shorter than 32 bytes.
JWT_SECRET=change-me

# ---------------------------------------------------------------------------
# OPTIONAL — payment providers. The backend boots without these and the payment
# routes return 503 `payments-not-configured`. Leave them blank while testing;
# fill them in when you are ready to charge customers.
#
# In production a variable that IS set is still validated against placeholders,
# so a half-filled provider fails loudly rather than silently misbehaving.
# ---------------------------------------------------------------------------

# Lemon Squeezy (payments). Get these from the Lemon Squeezy dashboard:
# API keys, store, product, variants, and webhook signing secret.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_PORTAL_ENABLED=true

# DEPRECATED — transitional only.
# Xendit (merchant payments; Stripe unavailable for Indonesia-registered merchants. Global USD billing.)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_CURRENCY=USD
XENDIT_COUNTRY=ID
# Amount charged at checkout, in the currency's minor units, per interval.
# Xendit's subscription flow creates a per-user recurring plan from the checkout session,
# so no plan id is configured here; the plan id is linked per-user from webhooks.
XENDIT_PRICE_PRO_MONTHLY_MINOR=
XENDIT_PRICE_PRO_YEARLY_MINOR=
# Optional one-time top-up (invoice.paid)
# XENDIT_INVOICE_PRODUCT_PRO=prod_xxx
